{% extends "base.jinja" %}

{% block title %}Forgot password{% endblock %}

{% block page_class %}page--narrow{% endblock %}

{% block content %}
    <div class="page-head">
        <div>
            <h1>Forgot password</h1>
            <p class="page-head__sub">We'll email you a link to set a new one.</p>
        </div>
    </div>

    <form method="post" action="{{ url_for('auth.forgot_password') }}">
        <div class="field">
            <label class="field__label" for="email">Email address</label>
            <input type="email"
                   id="email"
                   name="email"
                   required
                   autocomplete="email"
                   autofocus />
        </div>
        <div class="form__actions">
            <button type="submit" class="btn">Send reset link</button>
            <a href="{{ url_for('auth.login') }}" class="btn">Cancel</a>
        </div>
    </form>
{% endblock %}
