{% extends "base.jinja" %}

{% block title %}Sign in{% endblock %}

{% block page_class %}page--narrow{% endblock %}

{% block content %}
    <div class="page-head">
        <h1>Sign in</h1>
    </div>

    <form method="post" action="{{ url_for('auth.login') }}">
        {% if config.DEBUG %}
            <p class="muted">Dev login</p>
        {% else %}
            <div class="field">
                <label class="field__label" for="email">Email address</label>
                <input type="email"
                       id="email"
                       name="email"
                       required
                       autocomplete="email"
                       autofocus />
            </div>
            <div class="field">
                <label class="field__label" for="password">Password</label>
                <input type="password"
                       id="password"
                       name="password"
                       required
                       autocomplete="current-password" />
            </div>
        {% endif %}
        <div class="form__actions">
            <button type="submit" class="btn">Sign in</button>
        </div>
    </form>

    {% if not config.DEBUG %}
        <p>
            <a href="{{ url_for('auth.forgot_password') }}">Forgot your password?</a>
        </p>
    {% endif %}
{% endblock %}
