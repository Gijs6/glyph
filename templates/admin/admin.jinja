{% extends "base.jinja" %}

{% block title %}Admin{% endblock %}

{% block content %}
    <div class="page-head">
        <h1>Admin</h1>
        <div class="page-head__actions">
            <a href="{{ url_for('admin.users') }}" class="btn">Manage users</a>
        </div>
    </div>

    <div class="table-wrap">
        <table class="table table--kv table--fit">
            <caption class="visually-hidden">Summary</caption>
            <tbody>
                <tr>
                    <th scope="row">Users</th>
                    <td>{{ "{:,}".format(counts.users) }}</td>
                    <th scope="row">Pages</th>
                    <td>{{ "{:,}".format(counts.pages) }}</td>
                    <th scope="row">Menus</th>
                    <td>{{ "{:,}".format(counts.menus) }}</td>
                </tr>
            </tbody>
        </table>
    </div>
{% endblock %}
