{% extends "base.jinja" %}

{% block title %}New user{% endblock %}

{% block content %}
    <div class="page-head">
        <h1>New user</h1>
    </div>

    <form method="post" action="{{ url_for('admin.new_user') }}">
        <fieldset class="fieldset">
            <legend>User</legend>
            <div class="field">
                <label class="field__label" for="email">Email address</label>
                <input type="email"
                       id="email"
                       name="email"
                       required
                       autocomplete="email"
                       autofocus />
                <p class="field__hint">They'll get an email with a link to set their own password</p>
            </div>
            <div class="field">
                <label class="field__check">
                    <input type="checkbox" id="is_admin" name="is_admin" />
                    Make this user an admin
                </label>
            </div>
            <div class="form__actions">
                <button class="btn" type="submit">Add user</button>
                <a href="{{ url_for('admin.users') }}" class="btn">Cancel</a>
            </div>
        </fieldset>
    </form>
{% endblock %}
