{% extends "base.jinja" %}

{% block title %}Account{% endblock %}

{% block content %}
    <div class="page-head">
        <h1>Account</h1>
    </div>

    <fieldset class="fieldset">
        <legend>Profile</legend>
        <div class="field">
            <label class="field__label" for="email">Email address</label>
            <input type="email" id="email" value="{{ user.email }}" disabled />
        </div>
    </fieldset>

    <form method="post" action="{{ url_for('account.change_password') }}">
        <fieldset class="fieldset">
            <legend>Change password</legend>
            <div class="field">
                <label class="field__label" for="current_password">Current password</label>
                <input type="password"
                       id="current_password"
                       name="current_password"
                       required
                       autocomplete="current-password" />
            </div>
            <div class="field">
                <label class="field__label" for="password">New password</label>
                <input type="password"
                       id="password"
                       name="password"
                       required
                       minlength="8"
                       autocomplete="new-password" />
            </div>
            <div class="field">
                <label class="field__label" for="confirm_password">Confirm new password</label>
                <input type="password"
                       id="confirm_password"
                       name="confirm_password"
                       required
                       minlength="8"
                       autocomplete="new-password" />
            </div>
            <div class="form__actions">
                <button class="btn" type="submit">Save password</button>
            </div>
        </fieldset>
    </form>
{% endblock %}
